<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全面屏适配时，系统栏内边距之外额外保留的呼吸空间 -->
    <dimen name="screen_edge_padding">8dp</dimen>

    <!-- 页面内容的标准水平边距 -->
    <dimen name="content_padding_horizontal">16dp</dimen>

    <!-- 卡片的统一圆角 -->
    <dimen name="card_corner_radius">18dp</dimen>

    <!-- 诊断信息区块的圆角。比卡片略小，因为它处于卡片内部、体量更小 -->
    <dimen name="diagnostic_corner_radius">12dp</dimen>
</resources>
