<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份规则 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="link_history.json" />
        <exclude domain="sharedpref" path="cliplink_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="link_history.json" />
        <exclude domain="sharedpref" path="cliplink_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
