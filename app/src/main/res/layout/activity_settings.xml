<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant"
    android:orientation="vertical">

    <!--
        工具栏固定在顶部不随内容滚动：滚动时保持可返回，且其背景色能填满状态栏区域，
        与系统栏视觉连续。
    -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings_title"
        app:titleTextColor="@color/on_surface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <!--
            设置项容器。每个设置项独占一张圆角卡片；展开/收起动画以它为
            sceneRoot，流体云设置展开时下方卡片的位置会一起平滑过渡。
        -->
        <LinearLayout
            android:id="@+id/settingsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- 焦点通知（流体云）：展开/收起动画见 SettingsActivity.setFocusDurationVisible -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClipLink.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/focusNotificationSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp"
                        android:text="@string/setting_focus_notification"
                        android:textColor="@color/on_surface" />

                    <TextView
                        style="@style/TextAppearance.ClipLink.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingBottom="10dp"
                        android:text="@string/setting_focus_notification_desc" />

                    <!--
                        停留时长：仅在焦点通知开启时显示（带展开动画）。
                        Slider 的取值在代码里与 Prefs 双向绑定（1–60 秒）。
                    -->
                    <LinearLayout
                        android:id="@+id/focusDurationGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp">

                            <TextView
                                style="@style/TextAppearance.ClipLink.Body"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/setting_focus_duration"
                                android:textColor="@color/on_surface_variant" />

                            <TextView
                                android:id="@+id/focusDurationValue"
                                style="@style/TextAppearance.ClipLink.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/on_surface" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/focusDurationSlider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:stepSize="1"
                            android:valueFrom="1"
                            android:valueTo="60"
                            app:labelBehavior="floating" />

                        <TextView
                            style="@style/TextAppearance.ClipLink.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingBottom="10dp"
                            android:text="@string/focus_duration_hint" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 检测到网址后直接打开 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClipLink.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/autoOpenSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp"
                        android:text="@string/setting_auto_open"
                        android:textColor="@color/on_surface" />

                    <TextView
                        style="@style/TextAppearance.ClipLink.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingBottom="10dp"
                        android:text="@string/setting_auto_open_desc" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 仅 Wi-Fi 下监测 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClipLink.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/wifiOnlySwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp"
                        android:text="@string/setting_wifi_only"
                        android:textColor="@color/on_surface" />

                    <TextView
                        style="@style/TextAppearance.ClipLink.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingBottom="10dp"
                        android:text="@string/setting_wifi_only_desc" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 仅充电时监测 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClipLink.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/chargingOnlySwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp"
                        android:text="@string/setting_charging_only"
                        android:textColor="@color/on_surface" />

                    <TextView
                        style="@style/TextAppearance.ClipLink.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingBottom="10dp"
                        android:text="@string/setting_charging_only_desc" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 忽略的域名 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClipLink.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.ClipLink.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_ignored" />

                    <TextView
                        style="@style/TextAppearance.ClipLink.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/ignored_hint_desc" />

                    <TextView
                        android:id="@+id/ignoredEmpty"
                        style="@style/TextAppearance.ClipLink.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/ignored_empty" />

                    <LinearLayout
                        android:id="@+id/ignoredContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addIgnoredButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/action_add_ignored" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
