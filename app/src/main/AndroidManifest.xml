<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 通知提醒（Android 13+ 需要运行时授权） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 前台服务：承载 Shizuku 绑定与监听器，避免进程被回收 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34" />

    <!-- 设置页读取当前网络类型（仅 Wi-Fi 模式）与充电状态 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        电池优化豁免：权限任务清单的「允许后台行为」用它弹出系统确认框，
        避免前台监测服务被省电策略回收。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        实时更新（Live Updates）：焦点通知把链接提醒提升为系统状态栏胶囊，
        ColorOS 16+ 将其渲染为流体云。旧平台会忽略未知权限。
    -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!--
        Shizuku 授权权限。
        该权限由 Shizuku 应用声明，此处仅用于向系统声明依赖关系。
    -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!--
        包可见性：需要查询 Shizuku 是否安装、以及浏览器是否能处理 ACTION_VIEW。
        Android 11+ 下不声明 <queries> 会导致 getPackageInfo / resolveActivity 返回 null。
    -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />

        <!-- 用于 resolveActivity 判断是否有默认浏览器可打开链接 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:name=".ClipLinkApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipLink">

        <!-- 主界面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!--
            兜底读取：半透明无界面 Activity。
            主题必须是 translucent，否则 Android 12+ 会显示启动图标闪屏；
            且不能加 FLAG_NOT_FOCUSABLE —— 拿不到焦点就读不到剪切板。
        -->
        <activity
            android:name=".ClipboardCheckActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ClipLink.Transparent" />

        <!-- 打开链接：同样透明，避免跳转瞬间闪白屏 -->
        <activity
            android:name=".OpenLinkActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ClipLink.OpenLink" />

        <!-- 前台服务 -->
        <service
            android:name=".ClipboardMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a Shizuku-based clipboard listener alive so copied URLs can be detected without polling the clipboard." />
        </service>

        <!--
            Shizuku UserService：由 Shizuku 以 shell 身份启动的独立进程，
            必须 exported 才能被 Shizuku 绑定。
        -->
        <service
            android:name="com.cliplink.shizuku.ClipboardUserService"
            android:exported="true"
            android:process=":clipboard" />

        <!-- Shizuku provider -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
